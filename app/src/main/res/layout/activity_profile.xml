<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/svProfile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_profile"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="0dp"
            android:layout_height="@dimen/_45sdp"
            android:background="@color/bg_2"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:background="@color/bg_2"
                android:contentDescription="@string/back"
                android:padding="@dimen/_10sdp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/brown" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:text="@string/profile_title"
                android:textColor="@color/brown"
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivWoodLeft1"
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_45sdp"
            android:layout_marginStart="@dimen/_60sdp"
            android:contentDescription="@null"
            android:elevation="-1dp"
            android:src="@drawable/rectangle"
            app:layout_constraintBottom_toTopOf="@id/cvProfile"
            app:layout_constraintStart_toStartOf="@id/cvProfile"
            app:layout_constraintTop_toBottomOf="@id/layoutHeader" />

        <ImageView
            android:id="@+id/ivWoodRight1"
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_45sdp"
            android:layout_marginEnd="@dimen/_60sdp"
            android:contentDescription="@null"
            android:elevation="-1dp"
            android:src="@drawable/rectangle"
            app:layout_constraintBottom_toTopOf="@id/cvProfile"
            app:layout_constraintEnd_toEndOf="@id/cvProfile"
            app:layout_constraintTop_toBottomOf="@id/layoutHeader" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cvProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_25sdp"
            app:cardCornerRadius="@dimen/_15sdp"
            app:cardElevation="-4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutHeader">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_2"
                android:orientation="vertical"
                android:padding="@dimen/_15sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/profile"
                    android:gravity="center_vertical"
                    android:padding="@dimen/_5sdp">

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="@dimen/_65sdp"
                        android:layout_height="@dimen/_65sdp"
                        android:contentDescription="@string/username"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_launcher_foreground" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvUsername"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/username"
                            android:textColor="@color/brown"
                            android:textSize="@dimen/_15ssp"
                            android:textStyle="bold" />





                        <TextView
                            android:id="@+id/tvBuddyStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Trạng thái quét: Tắt"
                            android:textColor="@color/brown"
                            android:textSize="@dimen/_12ssp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvIntroduction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:gravity="center"
                    android:text="@string/introduction"
                    android:textColor="@color/brown"
                    android:textSize="@dimen/_12ssp" />

                <TextView
                    android:id="@+id/btnUpdateProfile"
                    android:layout_width="@dimen/_200sdp"
                    android:layout_height="@dimen/_45sdp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/bg_button"
                    android:text="@string/update_profile"
                    android:textAllCaps="false"
                    android:textColor="@color/brown"
                    android:textSize="@dimen/_15ssp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/ivWoodLeft2"
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_45sdp"
            android:layout_marginStart="@dimen/_60sdp"
            android:contentDescription="@null"
            android:elevation="-1dp"
            android:src="@drawable/rectangle"
            app:layout_constraintBottom_toTopOf="@id/cvInfo"
            app:layout_constraintStart_toStartOf="@id/cvInfo"
            app:layout_constraintTop_toBottomOf="@id/cvProfile" />

        <ImageView
            android:id="@+id/ivWoodRight2"
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_45sdp"
            android:layout_marginEnd="@dimen/_60sdp"
            android:contentDescription="@null"
            android:elevation="-1dp"
            android:src="@drawable/rectangle"
            app:layout_constraintBottom_toTopOf="@id/cvInfo"
            app:layout_constraintEnd_toEndOf="@id/cvInfo"
            app:layout_constraintTop_toBottomOf="@id/cvProfile" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cvInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_20sdp"
            app:cardCornerRadius="@dimen/_15sdp"
            app:cardElevation="-4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cvProfile">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_2"
                android:orientation="vertical"
                android:padding="@dimen/_15sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/infor"
                    android:textColor="@color/brown"
                    android:textSize="@dimen/_15ssp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@color/profile"
                    android:orientation="vertical"
                    android:padding="@dimen/_5sdp">

                    <TextView
                        android:id="@+id/tvAge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/age"
                        android:textColor="@color/brown"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:id="@+id/tvGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sex"
                        android:textColor="@color/brown"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:id="@+id/tvSchool"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/school"
                        android:textColor="@color/brown"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:id="@+id/tvMajor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/major"
                        android:textColor="@color/brown"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:id="@+id/tvCountry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/country"
                        android:textColor="@color/brown"
                        android:textSize="@dimen/_12ssp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cvFavorite"
            android:layout_width="0dp"
            android:layout_height="@dimen/_80sdp"
            android:layout_marginStart="@dimen/_26sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            app:cardCornerRadius="@dimen/_15sdp"
            app:cardElevation="-3dp"
            app:layout_constraintEnd_toStartOf="@id/cvAppointment"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cvInfo">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg_2"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFavorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/favorite"
                    android:textColor="@color/brown"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFavoriteRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:text="100.0"
                    android:textColor="@color/brown"
                    android:textSize="@dimen/_16ssp"
                    android:textStyle="bold"
                    tools:text="100.0" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cvAppointment"
            android:layout_width="0dp"
            android:layout_height="@dimen/_80sdp"
            android:layout_marginHorizontal="@dimen/_4sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="@dimen/_15sdp"
            app:cardElevation="2dp"
            app:layout_constraintEnd_toStartOf="@id/cvHonor"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/cvFavorite"
            app:layout_constraintTop_toBottomOf="@id/cvInfo">

            <LinearLayout
                android:id="@+id/layoutAppointmentInner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg_2"
                android:clickable="false"
                android:focusable="false"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppointment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="@string/appointment"
                    android:textColor="@color/brown"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAppointmentCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="0"
                    android:textColor="@color/brown"
                    android:textSize="@dimen/_16ssp"
                    android:textStyle="bold"
                    tools:text="0" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cvHonor"
            android:layout_width="0dp"
            android:layout_height="@dimen/_80sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_25sdp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="@dimen/_15sdp"
            app:cardElevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/cvAppointment"
            app:layout_constraintTop_toBottomOf="@id/cvInfo">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg_2"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHonor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Môn học"
                    android:textColor="@color/brown"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubjectCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:text="0"
                    android:textColor="@color/brown"
                    android:textSize="@dimen/_16ssp"
                    android:textStyle="bold"
                    tools:text="0" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/ivWoodFavLeft"
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginStart="@dimen/_15sdp"
            android:elevation="-1dp"
            android:src="@drawable/rectangle"
            app:layout_constraintBottom_toTopOf="@id/cvFavorite"
            app:layout_constraintStart_toStartOf="@id/cvFavorite"
            app:layout_constraintTop_toBottomOf="@id/cvInfo" />

        <ImageView
            android:id="@+id/ivWoodFavRight"
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginEnd="@dimen/_15sdp"
            android:elevation="-1dp"
            android:src="@drawable/rectangle"
            app:layout_constraintBottom_toTopOf="@id/cvFavorite"
            app:layout_constraintEnd_toEndOf="@id/cvFavorite"
            app:layout_constraintTop_toBottomOf="@id/cvInfo" />

        <ImageView
            android:id="@+id/ivWoodAppointLeft"
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginStart="@dimen/_15sdp"
            android:elevation="-1dp"
            android:src="@drawable/rectangle"
            app:layout_constraintBottom_toTopOf="@id/cvAppointment"
            app:layout_constraintStart_toStartOf="@id/cvAppointment"
            app:layout_constraintTop_toBottomOf="@id/cvInfo" />

        <ImageView
            android:id="@+id/ivWoodAppointRight"
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginEnd="@dimen/_15sdp"
            android:elevation="1dp"
            android:src="@drawable/rectangle"
            app:layout_constraintBottom_toTopOf="@id/cvAppointment"
            app:layout_constraintEnd_toEndOf="@id/cvAppointment"
            app:layout_constraintTop_toBottomOf="@id/cvInfo" />

        <ImageView
            android:id="@+id/ivWoodHonorLeft"
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginStart="@dimen/_15sdp"
            android:elevation="1dp"
            android:src="@drawable/rectangle"
            app:layout_constraintBottom_toTopOf="@id/cvHonor"
            app:layout_constraintStart_toStartOf="@id/cvHonor"
            app:layout_constraintTop_toBottomOf="@id/cvInfo" />

        <ImageView
            android:id="@+id/ivWoodHonorRight"
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginEnd="@dimen/_15sdp"
            android:elevation="1dp"
            android:src="@drawable/rectangle"
            app:layout_constraintBottom_toTopOf="@id/cvHonor"
            app:layout_constraintEnd_toEndOf="@id/cvHonor"
            app:layout_constraintTop_toBottomOf="@id/cvInfo" />

        <ImageView
            android:id="@+id/ivWoodBottomLeft"
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_30sdp"
            android:elevation="8dp"
            android:src="@drawable/rectangle"
            app:layout_constraintBottom_toTopOf="@id/cvSettings"
            app:layout_constraintEnd_toEndOf="@id/cvFavorite"
            app:layout_constraintStart_toStartOf="@id/cvFavorite"
            app:layout_constraintTop_toBottomOf="@id/cvFavorite" />

        <ImageView
            android:id="@+id/ivWoodBottomRight"
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_30sdp"
            android:elevation="8dp"
            android:src="@drawable/rectangle"
            app:layout_constraintBottom_toTopOf="@id/cvSettings"
            app:layout_constraintEnd_toEndOf="@id/cvHonor"
            app:layout_constraintStart_toStartOf="@id/cvHonor"
            app:layout_constraintTop_toBottomOf="@id/cvHonor" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cvSettings"
            android:layout_width="0dp"
            android:layout_height="@dimen/_45sdp"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_10sdp"
            app:cardCornerRadius="@dimen/_15sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cvFavorite">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg_2"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/_5sdp">

                <ImageView
                    android:id="@+id/ivSettingsIcon"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:contentDescription="@string/setting"
                    android:padding="@dimen/_12sdp"
                    android:src="@drawable/icon" />

                <TextView
                    android:id="@+id/tvSettingsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:text="@string/setting"
                    android:textColor="@color/brown"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>