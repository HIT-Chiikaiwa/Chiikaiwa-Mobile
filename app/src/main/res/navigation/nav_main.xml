<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main">

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.myapplication.ui.profile.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile">
        <argument
            android:name="target_user_id"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
        <action
            android:id="@+id/action_profileFragment_to_accountSettingsFragment"
            app:destination="@id/accountSettingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.myapplication.ui.profile.EditProfileFragment"
        android:label="fragment_edit_profile"
        tools:layout="@layout/fragment_edit_profile" />

    <fragment
        android:id="@+id/accountSettingsFragment"
        android:name="com.example.myapplication.ui.profile.AccountSettingsFragment"
        android:label="fragment_account_settings"
        tools:layout="@layout/fragment_account_settings">
        <action
            android:id="@+id/action_accountSettingsFragment_to_registrationInfoFragment"
            app:destination="@id/registrationInfoFragment" />
        <action
            android:id="@+id/action_accountSettingsFragment_to_changePasswordFragment"
            app:destination="@id/changePasswordFragment" />
        <action
            android:id="@+id/action_accountSettingsFragment_to_notificationSettingsFragment"
            app:destination="@id/notificationSettingsFragment" />
        <action
            android:id="@+id/action_accountSettingsFragment_to_blockedUsersFragment"
            app:destination="@id/blockedUsersFragment" />
    </fragment>

    <fragment
        android:id="@+id/registrationInfoFragment"
        android:name="com.example.myapplication.ui.profile.RegistrationInfoFragment"
        android:label="fragment_registration_info"
        tools:layout="@layout/fragment_registration_info" />

    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.example.myapplication.ui.profile.ChangePasswordFragment"
        android:label="fragment_change_password"
        tools:layout="@layout/fragment_change_password" />

    <fragment
        android:id="@+id/notificationSettingsFragment"
        android:name="com.example.myapplication.ui.profile.NotificationSettingsFragment"
        android:label="fragment_notification_settings"
        tools:layout="@layout/fragment_notification_settings" />

    <fragment
        android:id="@+id/blockedUsersFragment"
        android:name="com.example.myapplication.ui.profile.BlockedUsersFragment"
        android:label="fragment_blocked_users"
        tools:layout="@layout/fragment_blocked_users" />

    <fragment
        android:id="@+id/friendsListFragment"
        android:name="com.example.myapplication.ui.home.chat.FriendsListFragment"
        android:label="fragment_friends_list"
        tools:layout="@layout/fragment_friends_list">
        <action
            android:id="@+id/action_friendsListFragment_to_searchUserFragment"
            app:destination="@id/searchUserFragment" />
        <action
            android:id="@+id/action_friendsListFragment_to_pendingRequestsFragment"
            app:destination="@id/pendingRequestsFragment" />
        <action
            android:id="@+id/action_friendsListFragment_to_chatFragment"
            app:destination="@id/chatFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchUserFragment"
        android:name="com.example.myapplication.ui.home.chat.SearchUserFragment"
        android:label="fragment_search_user"
        tools:layout="@layout/fragment_search_user">
        <action
            android:id="@+id/action_searchUserFragment_to_chatFragment"
            app:destination="@id/chatFragment" />
    </fragment>

    <fragment
        android:id="@+id/pendingRequestsFragment"
        android:name="com.example.myapplication.ui.home.chat.PendingRequestsFragment"
        android:label="fragment_pending_requests"
        tools:layout="@layout/fragment_pending_requests" />

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.example.myapplication.ui.home.chat.chatroom.ChatFragment"
        android:label="fragment_chat"
        tools:layout="@layout/fragment_chat">
        <argument
            android:name="conversation_id"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="target_user_id"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="user_name"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="is_disabled"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

</navigation>